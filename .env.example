# -----------------------------------------------------------------------------
# Core settings
# -----------------------------------------------------------------------------
# DataForSEO powers most SEO data features (see docs/DATAFORSEO_API_KEY.md).
# Leaving it unset is how you disable it: rank checks then use the alternative
# providers below per engine, and trackers with no configured provider for
# their engine fail with the missing credential named instead of billing
# DataForSEO.
# DATAFORSEO_API_KEY=

# -----------------------------------------------------------------------------
# Alternative SEO data providers (all optional, phases of the provider
# migration). Unset variables are simply "not configured" — the first
# configured provider for an engine serves it (serper first for google,
# DataForSEO as its fallback).
# -----------------------------------------------------------------------------
# Google rank checks via serper.dev (https://serper.dev)
# SERPER_API_KEY=
# Yandex Search API (https://yandex.ru search API) — both values required
# YANDEX_SEARCH_API_KEY=
# YANDEX_FOLDER_ID=
# Baidu/Bing rank checks via Bright Data SERP API. The account/zone is
# operator-procured (Bright Data restricts some jurisdictions); the zone
# name defaults to "serp" if unset.
# BRIGHTDATA_API_TOKEN=
# BRIGHTDATA_SERP_ZONE=

# Keyword volumes from Google's own Keyword Planner data via the Google Ads
# API — BYO (your own Cloud project + Ads account; free, Basic access).
# Used for non-Russia markets when DATAFORSEO_API_KEY is not set. The OAuth
# refresh token needs the adwords scope; client id/secret reuse the Google
# pair above.
# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_REFRESH_TOKEN=

# Optional app port
# PORT=3001

# Optional reverse-proxy hosts for Docker self-hosting
# ALLOWED_HOST=yourdomain.com

# Optional image tag override for Docker self-hosting
# OPEN_SEO_IMAGE=ghcr.io/every-app/open-seo:latest

# -----------------------------------------------------------------------------
# Auth mode
# -----------------------------------------------------------------------------
# - cloudflare_access: validate Cloudflare Access JWTs (recommended for deploys)
# - local_noauth: local trusted mode with injected admin user (admin@localhost)
# - hosted: Better Auth email/password + organization mode
# - oauth: self-hosted OpenID Connect sign-in with the operator's own IdP
#   (one isolated workspace per account)
#
# Defaults to cloudflare_access when unset.
# AUTH_MODE=cloudflare_access

# Required when AUTH_MODE=oauth: the public origin, a random 32+ char
# secret, and your IdP's issuer + client pair. Endpoints are discovered from
# <issuer>/.well-known/openid-configuration; register the IdP client with
# redirect URI <BETTER_AUTH_URL>/api/auth/oauth2/callback/sso.
# OAUTH_SIGNIN_SCOPES is optional (default "openid profile email").
# See docs/SELF_HOSTING_DOCKER.md.
# AUTH_MODE=oauth
# BETTER_AUTH_URL=http://localhost:3001
# BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# OAUTH_SIGNIN_ISSUER=https://idp.example.com/realms/main
# OAUTH_SIGNIN_CLIENT_ID=
# OAUTH_SIGNIN_CLIENT_SECRET=
# OAUTH_SIGNIN_SCOPES=

# Required when AUTH_MODE=cloudflare_access. See docs/SELF_HOSTING_CLOUDFLARE.md.
# TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# POLICY_AUD=your-cloudflare-access-aud-tag

# Required when AUTH_MODE=hosted
# BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# BETTER_AUTH_URL=http://localhost:3001
# GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
# POSTHOG_PUBLIC_KEY=replace-with-your-posthog-project-api-key
# POSTHOG_HOST=https://us.i.posthog.com
# LOOPS_API_KEY=replace-with-your-loops-api-key
# LOOPS_TRANSACTIONAL_VERIFY_EMAIL_ID=replace-with-your-loops-verify-template-id
# LOOPS_TRANSACTIONAL_RESET_PASSWORD_ID=replace-with-your-loops-reset-template-id
# LOOPS_TRANSACTIONAL_INVITATION_ID=replace-with-your-loops-invitation-template-id
# LOOPS_PRODUCT_UPDATES_LIST_ID=replace-with-your-loops-product-updates-list-id

# Optional in self-hosted modes. Required if you want Google Search Console
# integration and MCP tools. BETTER_AUTH_SECRET is also required for GSC (it
# encrypts the stored OAuth tokens). See docs/SELF_HOSTING_GOOGLE_SEARCH_CONSOLE.md.
# GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
# BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional: Yandex Webmaster integration (separate from YANDEX_SEARCH_API_KEY
# above — that key belongs to the Yandex Search API rank provider, not
# Webmaster). A "web services" app from https://oauth.yandex.ru with the
# webmaster:hostinfo and webmaster:verify permissions. BETTER_AUTH_SECRET (it
# encrypts the stored tokens) is also required. See
# docs/SELF_HOSTING_YANDEX_WEBMASTER.md.
# YANDEX_OAUTH_CLIENT_ID=replace-with-your-yandex-oauth-client-id
# YANDEX_OAUTH_CLIENT_SECRET=replace-with-your-yandex-oauth-client-secret

# Optional: lets site audits replay a saved Shopify crawler signature. A long
# random secret (32+ characters) that encrypts those signatures.
# CRAWLER_ACCESS_SECRET=replace-with-a-different-long-random-secret

# Optional: Context.dev key for the site audit "Render JavaScript" option.
# Docker has no browser, so the option is disabled until this is set.
# CONTEXT_API_KEY=

# Optional: Google PageSpeed Insights API key for audit Lighthouse checks.
# Without a key, audits use Google's shared keyless quota, which is often
# exhausted — every Lighthouse check then fails with a 429 quota error shown
# in the audit results. Get a key from the Google Cloud Console
# (PageSpeed Insights API) and set it here for a dedicated quota.
# PAGESPEED_API_KEY=
# Local development only: attach a remote Cloudflare Browser Run binding to
# the audit worker (needs `wrangler login`).
# AUDIT_BROWSER_RENDERING=true
